{
  "id": "task_filter_active",
  "title": "进行中任务筛选验收",
  "summary": "点击进行中筛选后只展示 active 任务，用来证明筛选风险不是单点特调。",
  "pagePath": "/tasks",
  "matcher": {
    "keywords": ["进行中", "active", "status=active", "任务筛选"],
    "riskLevel": "medium",
    "sourceHints": ["pr", "requirement"],
    "capabilities": ["browser_control", "screenshot", "dom", "network"]
  },
  "corePath": {
    "action": "click_and_assert",
    "pathId": "core_filter_active",
    "title": "点击进行中筛选并校验任务列表",
    "buttonSelectorRef": "task-filter-active-tab",
    "statusSelectorRef": "task-list",
    "expectedQueryFragment": "status=active",
    "expectedTextIncludes": "Review failed smoke run",
    "expectedTextExcludes": "Archive fulfilled orders"
  },
  "oracles": [
    {
      "id": "active_query",
      "kind": "network",
      "description": "筛选行为必须携带 status=active 查询意图。",
      "requiredEvidence": ["network-log", "dom-snapshot"]
    },
    {
      "id": "active_dom",
      "kind": "state",
      "description": "DOM 中不能混入 completed 任务。",
      "requiredEvidence": ["screenshot", "dom-snapshot"]
    }
  ]
}
