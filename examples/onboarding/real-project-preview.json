{
  "baseUrl": "https://preview.customer-portal.example.test",
  "project": {
    "slug": "customer-portal-preview",
    "name": "Customer Portal Preview QA",
    "description": "Representative real-project onboarding contract for a preview deployment."
  },
  "targetApp": {
    "name": "Customer Portal",
    "environments": ["preview", "staging"],
    "defaultMode": "ai-exploratory"
  },
  "auth": {
    "strategy": "session",
    "accountRef": "vault://accounts/customer-portal/qa-admin",
    "loginPagePath": "/signin",
    "notes": "Use a scoped QA admin account with seeded customer/order data only."
  },
  "runtime": {
    "profile": "preview",
    "projectRoot": "../customer-portal",
    "start": {
      "command": "pnpm",
      "args": ["preview", "--host", "127.0.0.1", "--port", "4173"],
      "cwd": "../customer-portal",
      "env": [
        {
          "name": "NODE_ENV",
          "value": "test",
          "scope": "launch"
        },
        {
          "name": "CUSTOMER_PORTAL_API_TOKEN",
          "secretRef": "vault://secrets/customer-portal/api-token",
          "required": true,
          "scope": "launch"
        }
      ],
      "timeoutMs": 120000
    },
    "healthCheck": {
      "url": "https://preview.customer-portal.example.test/healthz",
      "method": "GET",
      "expectedStatus": [200, 204],
      "timeoutMs": 5000,
      "intervalMs": 1000,
      "retries": 30
    },
    "cleanup": {
      "command": "pnpm",
      "args": ["run", "test:cleanup"],
      "cwd": "../customer-portal",
      "env": [
        {
          "name": "CUSTOMER_PORTAL_API_TOKEN",
          "secretRef": "vault://secrets/customer-portal/api-token",
          "required": true,
          "scope": "cleanup"
        }
      ],
      "timeoutMs": 60000
    },
    "routes": [
      {
        "id": "signin",
        "path": "/signin",
        "purpose": "login",
        "authenticated": false
      },
      {
        "id": "customers",
        "path": "/customers",
        "purpose": "workflow",
        "authenticated": true
      },
      {
        "id": "create-customer",
        "path": "/customers/new",
        "purpose": "workflow",
        "authenticated": true
      },
      {
        "id": "orders",
        "path": "/orders",
        "purpose": "workflow",
        "authenticated": true
      },
      {
        "id": "api-health",
        "path": "/api/health",
        "purpose": "api",
        "authenticated": true
      }
    ],
    "testAccounts": [
      {
        "id": "qa-admin",
        "role": "admin",
        "credentialRef": "vault://accounts/customer-portal/qa-admin",
        "scope": ["preview", "customers", "orders"]
      }
    ]
  },
  "keyPages": [
    {
      "id": "signin-page",
      "name": "Sign in",
      "path": "/signin",
      "tags": ["auth"]
    },
    {
      "id": "customers-page",
      "name": "Customers",
      "path": "/customers",
      "tags": ["golden-path", "list"]
    },
    {
      "id": "create-customer-page",
      "name": "Create customer",
      "path": "/customers/new",
      "tags": ["form"]
    },
    {
      "id": "orders-page",
      "name": "Orders",
      "path": "/orders",
      "tags": ["state-change", "orders"]
    }
  ],
  "businessObjective": "Verify a QA admin can sign in, review customers, create a customer record, and change an order state on the preview deployment.",
  "selectorHints": [
    {
      "id": "auth-login-submit",
      "pagePath": "/signin",
      "description": "Primary sign-in button.",
      "preferredStrategies": ["test-id", "role", "text"],
      "queries": ["data-testid=signin-submit", "role=button[name='Sign in']", "text=Sign in"]
    },
    {
      "id": "golden-path-primary-action",
      "pagePath": "/customers",
      "description": "Open the customer details panel from the customer list.",
      "preferredStrategies": ["test-id", "role"],
      "queries": ["data-testid=open-customer-cust-1001", "role=button[name='Open customer']"]
    },
    {
      "id": "golden-path-observer",
      "pagePath": "/customers",
      "description": "Customer details panel that proves the core workflow rendered.",
      "preferredStrategies": ["test-id", "text"],
      "queries": ["data-testid=customer-detail-panel", "text=Customer profile"]
    },
    {
      "id": "form-primary-input",
      "pagePath": "/customers/new",
      "description": "Customer name field.",
      "preferredStrategies": ["test-id", "label"],
      "queries": ["data-testid=customer-name", "label=Customer name"]
    },
    {
      "id": "form-submit",
      "pagePath": "/customers/new",
      "description": "Submit new customer form.",
      "preferredStrategies": ["test-id", "role"],
      "queries": ["data-testid=customer-save", "role=button[name='Create customer']"]
    },
    {
      "id": "form-success-indicator",
      "pagePath": "/customers/new",
      "description": "Successful customer creation confirmation.",
      "preferredStrategies": ["test-id", "text"],
      "queries": ["data-testid=customer-success", "text=Customer created"]
    },
    {
      "id": "list-state-change-trigger",
      "pagePath": "/orders",
      "description": "Ship a seeded order row.",
      "preferredStrategies": ["test-id", "role"],
      "queries": ["data-testid=ship-order-ord-1001", "role=button[name='Ship order']"]
    },
    {
      "id": "list-state-observer",
      "pagePath": "/orders",
      "description": "Orders list state after the row update.",
      "preferredStrategies": ["test-id", "text"],
      "queries": ["data-testid=orders-list", "text=Shipped"]
    }
  ],
  "scenarioRequests": [
    {
      "family": "auth-login",
      "name": "QA admin can sign in",
      "pagePath": "/signin",
      "fixtureRefs": ["fixture://customer-portal/accounts/qa-admin"],
      "evidenceRequirements": ["screenshot", "dom-snapshot", "console-log", "network-log"]
    },
    {
      "family": "golden-path",
      "name": "Customer detail panel opens",
      "pagePath": "/customers",
      "selectorHintIds": ["golden-path-primary-action", "golden-path-observer"],
      "fixtureRefs": ["fixture://customer-portal/customers/seeded"],
      "evidenceRequirements": ["screenshot", "dom-snapshot", "console-log"]
    },
    {
      "family": "form-submission",
      "name": "Create customer form submits",
      "pagePath": "/customers/new",
      "selectorHintIds": ["form-primary-input", "form-submit", "form-success-indicator"],
      "fixtureRefs": ["fixture://customer-portal/customers/new-record"],
      "evidenceRequirements": ["screenshot", "dom-snapshot", "console-log", "network-log"]
    },
    {
      "family": "list-state-change",
      "name": "Seeded order can be shipped",
      "pagePath": "/orders",
      "selectorHintIds": ["list-state-change-trigger", "list-state-observer"],
      "fixtureRefs": ["fixture://customer-portal/orders/seeded"],
      "evidenceRequirements": ["screenshot", "dom-snapshot", "console-log", "network-log"]
    }
  ]
}
