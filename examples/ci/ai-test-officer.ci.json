{
  "schemaVersion": "1.0",
  "gate": {
    "failOnNewFindings": true,
    "failOnRegression": true,
    "allowFlaky": false,
    "allowBlocked": false,
    "flakyQuarantine": {
      "enabled": true,
      "label": "qa/flaky-quarantined",
      "reason": "Flaky runs must be quarantined deliberately instead of silently passing CI."
    }
  },
  "artifacts": {
    "retentionDays": 14,
    "includeManifest": true,
    "includeReports": true,
    "includeRegistry": true,
    "includeEvidence": false,
    "includeArtifacts": true,
    "includeTraces": true,
    "includeVideos": true,
    "maxUploadBytes": 52428800,
    "largeArtifactStrategy": "skip-over-limit"
  },
  "prAnnotations": {
    "enabled": true,
    "maxItems": 10,
    "includeDiagnostics": true
  }
}
