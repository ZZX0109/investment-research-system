{
  "id": "task_error_recovery",
  "title": "任务接口错误恢复验收",
  "summary": "触发错误态后必须出现可恢复提示，并允许用户回到全部任务。",
  "pagePath": "/tasks",
  "matcher": {
    "keywords": ["500", "error", "timeout", "错误恢复", "接口失败"],
    "riskLevel": "high",
    "sourceHints": ["bug", "patrol"],
    "capabilities": ["browser_control", "screenshot", "dom", "console"]
  },
  "corePath": {
    "action": "trigger_error",
    "pathId": "core_error_recovery",
    "title": "触发错误态并校验恢复提示",
    "buttonSelectorRef": "task-error-trigger",
    "statusSelectorRef": "task-error-banner",
    "expectedQueryFragment": "status=error",
    "expectedTextIncludes": "Task service is unavailable"
  },
  "oracles": [
    {
      "id": "error_banner",
      "kind": "text",
      "description": "错误态必须给出明确恢复提示。",
      "requiredEvidence": ["screenshot", "dom-snapshot", "console-log"]
    }
  ]
}
