{
  "id": "task_filter_completed",
  "title": "已完成任务筛选验收",
  "summary": "点击已完成筛选后只展示 completed 任务，并记录 status=completed 查询意图。",
  "pagePath": "/tasks",
  "matcher": {
    "keywords": ["已完成", "completed", "status=completed", "任务筛选"],
    "riskLevel": "high",
    "sourceHints": ["pr", "requirement", "bug"],
    "capabilities": ["browser_control", "screenshot", "dom", "network"]
  },
  "corePath": {
    "action": "click_and_assert",
    "pathId": "core_filter_completed",
    "title": "点击已完成筛选并校验任务列表",
    "buttonSelectorRef": "task-filter-completed-tab",
    "statusSelectorRef": "task-list",
    "expectedQueryFragment": "status=completed",
    "expectedTextIncludes": "Archive fulfilled orders",
    "expectedTextExcludes": "Review failed smoke run",
    "expectedFailure": true
  },
  "oracles": [
    {
      "id": "completed_query",
      "kind": "network",
      "description": "筛选行为必须携带 status=completed 查询意图。",
      "requiredEvidence": ["network-log", "dom-snapshot"]
    },
    {
      "id": "completed_dom",
      "kind": "state",
      "description": "DOM 中不能混入 active 任务。",
      "requiredEvidence": ["screenshot", "dom-snapshot"]
    }
  ]
}
