INVESTMENT_RESEARCH_ENV=development
INVESTMENT_RESEARCH_DATABASE_PATH=./var/investment_research.db
# PostgreSQL is required in production. SQLite remains a local development compatibility store.
INVESTMENT_RESEARCH_DATABASE_URL=sqlite:///./var/investment_research.db
INVESTMENT_RESEARCH_OBJECT_STORE_ENDPOINT=
INVESTMENT_RESEARCH_OBJECT_STORE_BUCKET=investment-research
# Formal local PostgreSQL/MinIO validation:
# INVESTMENT_RESEARCH_DATABASE_URL=postgresql://investment_research:<password>@127.0.0.1:54329/investment_research
# INVESTMENT_RESEARCH_OBJECT_STORE_ENDPOINT=http://127.0.0.1:59000
# AWS_ACCESS_KEY_ID=<minio-access-key>
# AWS_SECRET_ACCESS_KEY=<minio-secret-key>
INVESTMENT_RESEARCH_LOG_LEVEL=INFO
INVESTMENT_RESEARCH_REDACT_SENSITIVE_LOGS=true

# Auth
# Required outside development/demo/test.
INVESTMENT_RESEARCH_SECRET_KEY=replace-with-32-byte-secret
INVESTMENT_RESEARCH_ACCESS_TTL_MINUTES=15
INVESTMENT_RESEARCH_REFRESH_TTL_DAYS=14
INVESTMENT_RESEARCH_COOKIE_SECURE=false
INVESTMENT_RESEARCH_COOKIE_SAMESITE=lax
INVESTMENT_RESEARCH_COOKIE_DOMAIN=
INVESTMENT_RESEARCH_COOKIE_PATH=/

# API boundaries
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_REQUEST_SIZE_LIMIT_BYTES=1048576
DOCUMENT_UPLOAD_REQUEST_SIZE_LIMIT_BYTES=22020096
API_RATE_LIMIT_PER_MINUTE=120

# Encrypted credential vault
# Required outside development/demo/test.
AI_TEST_OFFICER_CREDENTIAL_MASTER_KEY=replace-with-32-byte-key-or-base64
AI_TEST_OFFICER_CREDENTIAL_STORE_PATH=./runs/secrets/credentials.json

# Artifact and agent access
AI_TEST_OFFICER_ARTIFACT_TOKEN=replace-with-strong-token
AI_TEST_OFFICER_AGENT_API_TOKEN=replace-with-strong-token
# Use the audited real/full bundles in output/ as the analysis-run intake source.
# Leave these as persisted_fallback when operators populate PriceSeries/Evidence through the API.
INVESTMENT_RESEARCH_MARKET_DATA_PROVIDER=bundle_backed
INVESTMENT_RESEARCH_EVIDENCE_PROVIDER=bundle_backed
# Production must name two licensed provider adapters. AKShare is research/backfill only.
INVESTMENT_RESEARCH_MARKET_DATA_PRIMARY_PROVIDER=
INVESTMENT_RESEARCH_MARKET_DATA_BACKUP_PROVIDER=
# Minute collection remains disabled until provider SLA acceptance is complete.
INVESTMENT_RESEARCH_MINUTE_COLLECTION_ENABLED=false


# Optional local visual inspection. Disabled by default; model output never becomes a trusted numeric fact.
RESEARCH_VISION_PROVIDER=disabled
RESEARCH_OLLAMA_VISION_ENDPOINT=http://127.0.0.1:11434/api/generate
RESEARCH_OLLAMA_VISION_MODEL=llava
RESEARCH_DOCUMENT_SOURCE_ALLOWLIST=sec.gov,cninfo.com.cn,hkexnews.hk,sse.com.cn,szse.cn
RESEARCH_AUDIT_NETWORK_ENABLED=false
RESEARCH_AUDIT_SOURCE_ALLOWLIST=sec.gov,cninfo.com.cn,hkexnews.hk,sse.com.cn,szse.cn,nasdaq.com,nyse.com
